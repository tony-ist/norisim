{
  "name": "norisim",
  "private": true,
  "version": "0.0.0",
  "description": "Web-based simulator for the NORI Minecraft CPU",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --fix",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "tscheck": "tsc --noEmit",
    "assemble": "tsx scripts/assemble.ts",
    "rnd": "tsx scripts/rnd.ts"
  },
  "pre-commit": [
    "lint:fix",
    "build",
    "test"
  ],
  "engines": {
    "node": "25.2.1",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@reduxjs/toolkit": "^2.11.0",
    "ohm-js": "^17.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "pre-commit": "^1.2.2",
    "tsx": "^4.6.2",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.49.0",
    "vite": "^4.4.5",
    "vitest": "^4.0.15"
  },
  "author": "Anton Istomin",
  "license": "ISC"
}
