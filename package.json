{
  "name": "norisim",
  "private": true,
  "version": "0.0.0",
  "description": "Web-based simulator for the NORI Minecraft CPU",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "tscheck": "tsc --noEmit",
    "assemble": "tsx scripts/assemble.ts",
    "rnd": "tsx scripts/rnd.ts"
  },
  "engines": {
    "node": "25.2.1",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.3",
    "@mui/material": "^5.14.2",
    "ohm-js": "^17.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "tsx": "^4.6.2",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^0.33.0"
  },
  "author": "Anton Istomin",
  "license": "ISC"
}
