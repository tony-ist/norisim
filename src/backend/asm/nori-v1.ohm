ISA {
    program = programLine*

    programLine = emptyLine | commentLine | instructionLine

    instructionLine = inlineSpace* instruction inlineSpace* (inlineComment)? newline

    commentLine = inlineSpace* comment newline

    emptyLine = inlineSpace* newline

    inlineComment = comment

    comment = "//" (~newline any)*

    instruction = (label space+)? mnemonic caseInsensitive<".f">? (inlineSpace+ operandList)?

    operandList = operand (sep operand)*

    operand = register | label | immediate

    register = caseInsensitive<"r"> digit

    immediate = "-"? digit+

    label = "." letterOrDigit+

    mnemonic = letter+

    sep = inlineSpace* "," inlineSpace*

    newline = "\n"

    letterOrDigit = letter | digit | "_"

    inlineSpace = ~newline space
}
