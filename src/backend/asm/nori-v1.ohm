ISA {
    program = programLine*

    programLine = emptyLine | commentLine | instructionLine

    instructionLine = inlineSpace* instruction (inlineSpace+ inlineComment)? newline

    commentLine = inlineSpace* comment newline

    emptyLine = inlineSpace* newline

    inlineComment = comment

    comment = "//" (~newline any)*

    instruction = (label space+)? mnemonic caseInsensitive<".f">? (inlineSpace+ operands)?

    label = "." letterOrDigit+

    mnemonic 
        = caseInsensitive<"NOP">
        | caseInsensitive<"LIM">
        | caseInsensitive<"ADDI">
        | caseInsensitive<"ADD">
        | caseInsensitive<"SUB">
        | caseInsensitive<"AND">
        | caseInsensitive<"OR">
        | caseInsensitive<"XOR">
        | caseInsensitive<"NOT">
        | caseInsensitive<"SHR">
        | caseInsensitive<"JMP">
        | caseInsensitive<"JZ">
        | caseInsensitive<"JNZ">
        | caseInsensitive<"JC">
        | caseInsensitive<"JNC">
        | caseInsensitive<"JL">
        | caseInsensitive<"JG">
        | caseInsensitive<"JLE">
        | caseInsensitive<"JGE">
        | caseInsensitive<"CAL">
        | caseInsensitive<"RET">
        | caseInsensitive<"PSH">
        | caseInsensitive<"POP">
        | caseInsensitive<"MLD">
        | caseInsensitive<"MST">
        | caseInsensitive<"MOV">
        | caseInsensitive<"PST">
        | caseInsensitive<"PLD">
        | caseInsensitive<"HLT">

	operands = expression (sep expression)*

    expression = register | immediate | labelAddress

    register = "r0" | "r1" | "r2" | "r3" | "r4" | "r5" | "r6" | "r7"

    immediate = "-"?digit+

    labelAddress = "." letterOrDigit+

    sep = space* "," space*

    newline = "\n"

    letterOrDigit = letter | digit

    inlineSpace = (~newline space)+
}
