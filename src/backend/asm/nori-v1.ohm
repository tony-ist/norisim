ISA {
    program = programLine*

    programLine = emptyLine | commentLine | instructionLine

    instructionLine = inlineSpace* instruction (inlineSpace+ inlineComment)? newline

    commentLine = inlineSpace* comment newline

    emptyLine = inlineSpace* newline

    inlineComment = comment

    comment = "//" (~newline any)*

    instruction = (label space+)? instructionX

    instructionX
        = instructionI
        | instructionA
        | instructionB
        | instructionC
        | instructionD
        | instructionE
        | instructionJ
        | instructionZ

    instructionI = mnemonic space+ register sep immediate
    
    instructionA = mnemonic caseInsensitive<".f">? space+ register sep register sep register

    instructionB = mnemonic caseInsensitive<".f">? space+ register sep register

    instructionC = mnemonic space+ address sep register

    instructionD = mnemonic space+ register
    
    instructionE = mnemonic space+ register sep register

    instructionJ = mnemonic space+ label

    instructionZ = mnemonic

    label = "." letterOrDigit+

    mnemonic = letter+

    address = digit+

    register = "r0" | "r1" | "r2" | "r3" | "r4" | "r5" | "r6" | "r7"

    immediate = "-"? digit+

    sep = space* "," space*

    newline = "\n"

    letterOrDigit = letter | digit

    inlineSpace = (~newline space)+
}
