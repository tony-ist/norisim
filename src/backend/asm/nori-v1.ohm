ISA {
    program = programLine*

    programLine = emptyLine | commentLine | instructionLine

    instructionLine = inlineSpace* instruction inlineSpace* (inlineComment)? newline

    commentLine = inlineSpace* comment newline

    emptyLine = inlineSpace* newline

    inlineComment = comment

    comment = "//" (~newline any)*

    instruction = (label space+)? instructionX

    instructionX
        = data
        | instructionI
        | instructionA
        | instructionB
        | instructionC
        | instructionD
        | instructionJ
        | instructionZ

    instructionI = mnemonic inlineSpace+ register sep immediate
    
    instructionA = mnemonic caseInsensitive<".f">? inlineSpace+ register sep register sep register

    instructionB = mnemonic caseInsensitive<".f">? inlineSpace+ register sep register

    instructionC = mnemonic inlineSpace+ address sep register

    instructionD = mnemonic inlineSpace+ register

    instructionJ = mnemonic inlineSpace+ label

    instructionZ = mnemonic

    data = "db" inlineSpace+ immediate (sep immediate)*

    label = "." letterOrDigit+

    mnemonic = letter+

    address = digit+

    register = "r0" | "r1" | "r2" | "r3" | "r4" | "r5" | "r6" | "r7"

    immediate = "-"? digit+

    sep = inlineSpace* "," inlineSpace*

    newline = "\n"

    letterOrDigit = letter | digit | "_"

    inlineSpace = ~newline space
}
